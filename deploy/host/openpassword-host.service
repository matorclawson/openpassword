[Unit]
Description=OpenPassword agent host bridge
After=network-online.target

[Service]
User=openpassword-host
Group=openpassword-agents
EnvironmentFile=/etc/openpassword/host.env
Environment=OPENPASSWORD_HOST_HOME=/var/lib/openpassword-host
Environment=OPENPASSWORD_HOST_SOCKET=/run/openpassword-host/bridge.sock
StateDirectory=openpassword-host
StateDirectoryMode=0700
RuntimeDirectory=openpassword-host
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/local/bin/openpassword host serve
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
